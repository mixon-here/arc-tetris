rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isValidId(id) { 
        return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    
    function isValidScore(data) {
       return data.keys().hasAll(['walletAddress', 'score', 'lines', 'timestamp'])
         && data.keys().size() == 4
         && data.walletAddress is string
         && data.walletAddress.size() == 42
         && data.score is number
         && data.score >= 0
         && data.score <= 99999999
         && data.lines is number
         && data.lines >= 0
         && data.timestamp is number;
    }

    match /leaderboard/{scoreId} {
      allow read: if true;
      allow create: if isValidId(scoreId) 
        && isValidScore(incoming());
    }
  }
}
