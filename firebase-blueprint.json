{
  "entities": {
    "Score": {
      "title": "Player Score",
      "description": "A score submitted by a player for the leaderboard",
      "type": "object",
      "properties": {
        "walletAddress": { "type": "string" },
        "score": { "type": "number" },
        "lines": { "type": "number" },
        "timestamp": { "type": "number" }
      },
      "required": ["walletAddress", "score", "lines", "timestamp"]
    }
  },
  "firestore": {
    "/leaderboard/{docId}": {
      "schema": { "$ref": "#/entities/Score" },
      "description": "Global leaderboard entries."
    }
  }
}
